#!/bin/bash

# Show a fuzzy-finder TUI for picking AppImages in ~/Downloads to install.
# Mirrors omarchy-flatpak-install. Each AppImage is copied to ~/Applications
# under the id of its embedded .desktop file, so installing a newer download
# of the same app replaces the old one instead of adding a second copy.

downloads=$(xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads")
app_dir="$HOME/Applications"
desktop_dir="$HOME/.local/share/applications"
icon_dir="$HOME/.local/share/icons/appimage"

omarchy-pkg-add fuse2 || exit 1

# Print the path inside the extracted image that <path> finally points to,
# extracting each symlink target on the way. Absolute links into the build
# machine's AppDir (/.../Foo.AppDir/x) are taken relative to the image root.
resolve_in_image() {
  local src=$1 root=$2 path=$3 target _
  for _ in 1 2 3 4 5; do
    [[ -L $root/$path ]] || break
    target=$(readlink "$root/$path")
    if [[ $target == /* ]]; then
      [[ $target == *.AppDir/* ]] && target=${target#*.AppDir/} || target=${target#/}
    else
      target=$(dirname "$path")/$target
    fi
    path=$(realpath -m --relative-to=/ "/$target")
    (cd "$(dirname "$root")" && "$src" --appimage-extract "$path") >/dev/null 2>&1
  done
  echo "$path"
}

install_appimage() {
  local src=$1 tmp root link desktop id dest icon ext
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' RETURN
  root="$tmp/squashfs-root"

  chmod +x "$src"
  # Extract only the metadata; --appimage-extract works without FUSE.
  (cd "$tmp" && "$src" --appimage-extract '*.desktop' && "$src" --appimage-extract .DirIcon) >/dev/null 2>&1
  link=$(find "$root" -maxdepth 1 -name '*.desktop' -printf '%f\n' -quit 2>/dev/null)
  # The top-level .desktop is often a symlink into usr/share/applications.
  [[ -n $link ]] && desktop="$root/$(resolve_in_image "$src" "$root" "$link")"
  if [[ -z $link || ! -s $desktop ]]; then
    echo -e "\033[31mSkipping $(basename "$src"): no .desktop file inside\033[0m" >&2
    return 1
  fi

  id=$(basename "$link" .desktop)
  dest="$app_dir/$id.AppImage"

  if cmp -s "$src" "$dest" && [[ -s $desktop_dir/$id.desktop ]]; then
    echo "$id is already up to date"
    return 0
  fi
  [[ -f $dest ]] && echo "Updating $id" || echo "Installing $id"

  mkdir -p "$app_dir" "$desktop_dir" "$icon_dir"
  [[ $src -ef $dest ]] || { install -m0755 "$src" "$dest.new" && mv -f "$dest.new" "$dest"; } || return 1

  # .DirIcon is often a symlink into the image, sometimes an absolute one.
  icon="$root/$(resolve_in_image "$src" "$root" .DirIcon)"
  rm -f "$icon_dir/$id".*
  if [[ -f $icon && ! -L $icon ]]; then
    [[ $(file -b --mime-type "$icon") == image/svg* ]] && ext=svg || ext=png
    cp "$icon" "$icon_dir/$id.$ext"
    icon="$icon_dir/$id.$ext"
  else
    icon=application-x-executable
  fi

  sed -E \
    -e "s|^Exec=[^ ]+|Exec=\"$dest\"|" \
    -e "s|^Icon=.*|Icon=$icon|" \
    -e '/^TryExec=/d' \
    "$desktop" >"$desktop_dir/$id.desktop"
  update-desktop-database "$desktop_dir" &>/dev/null
}

fzf_args=(
  --multi
  --delimiter '/'
  --with-nth -1
  --header "AppImages in $downloads"
  --preview-label='tab: multi-select'
  --preview-label-pos='bottom'
  --color 'pointer:green,marker:green'
)

files=$(find "$downloads" -maxdepth 1 -type f -iname '*.appimage' -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-)

if [[ -z $files ]]; then
  echo "No AppImages found in $downloads"
  read -n 1 -s -r -p "Press any key to close"
  exit 0
fi

selected=$(fzf "${fzf_args[@]}" <<<"$files")

if [[ -n $selected ]]; then
  while IFS= read -r f; do
    install_appimage "$f"
  done <<<"$selected"
  omarchy-show-done
fi
